{
  "name": "@openforis/arena-core",
  "author": {
    "name": "OpenForis",
    "email": "openforis.arena@gmail.com"
  },
  "version": "2.18.3",
  "description": "Arena core module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openforis/arena-core.git"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/expression/javascript/parser/jsep.js",
    "./dist/esm/expression/javascript/parser/jsep.js",
    "./dist/utils/numbers.js",
    "./dist/esm/utils/numbers.js"
  ],
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^26.6.5",
    "@types/proj4": "^2.19.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-no-explicit-type-exports": "^0.12.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pinst": "^3.0.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "@jsep-plugin/regex": "^1.1.0",
    "@turf/bearing": "^7.4.0",
    "@turf/destination": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/point-to-polygon-distance": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "bignumber.js": "^11.1.5",
    "change-case": "^5.4.4",
    "dayjs": "^1.11.23",
    "jsep": "^1.6.0",
    "lodash.isequal": "^4.5.0",
    "n2words": "^6.3.0",
    "proj4": "^2.22.0",
    "uuid": "^14.0.3"
  },
  "scripts": {
    "build:watch": "tsc --watch",
    "build": "yarn clean && tsc && tsc -p tsconfig.esm.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "format:check": "prettier --check .",
    "lint:fix": "npm run lint -- --fix",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "postinstall": "husky",
    "postpack": "pinst --enable",
    "prepack": "pinst --disable && yarn build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "files": [
    "dist/**/*"
  ],
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --cache --fix",
    "*.{js,mjs,ts,tsx,json,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
